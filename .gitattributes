# Shell scripts MUST keep LF endings: they run inside Linux containers, and a CRLF shebang
# line fails with the confusing `/bin/sh^M: bad interpreter`. Git's autocrlf would otherwise
# convert them on a Windows checkout, so this is not cosmetic.
*.sh text eol=lf

# Same reasoning for anything else consumed inside a container.
Dockerfile text eol=lf
*.ini text eol=lf
*.conf text eol=lf
