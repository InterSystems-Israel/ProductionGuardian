# Health Scan dashboard — copy to `.env.local` to override. Never commit `.env*`.

# Base path the live client fetches from. Left as a relative path so the Vite dev
# proxy (vite.config.ts) handles it and CORS never applies.
VITE_HEALTHSCAN_BASE_URL=/api/healthscan

# Where the dev proxy forwards to — Dev B's findings API.
VITE_HEALTHSCAN_TARGET=http://localhost:3002

# Poll cadence. This is the LAST stage before the screen and the only one gated by no
# invariant, so it is the term to spend against the "updates within 10s" bar (#44) — every
# upstream interval trades against either the IRIS scrape rate or the engine's debounce.
# Do not read the two upstream intervals from here; they have both moved once already.
VITE_POLL_INTERVAL_MS=2000
