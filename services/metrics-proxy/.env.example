# Copy this file to .env and fill in your IRIS connection details.
# Never commit .env — it is in .gitignore.

IRIS_HOST=localhost
IRIS_PORT=52773
IRIS_USER=_SYSTEM
IRIS_PASS=SYS
IRIS_NAMESPACE=LABDEMO

# Path prefix in front of /api/monitor/. Leave empty when IRIS is served by its own
# private web server (the 52773 case). When IRIS is served through an external web
# server the instance name is a path segment, so check the URL that works in your
# browser and copy everything before /api/:
#
#   http://localhost:52773/api/monitor/metrics          -> IRIS_BASE_PATH=
#   http://localhost/iris4health_2024_1/api/monitor/... -> IRIS_BASE_PATH=/iris4health_2024_1
#                                                          with IRIS_PORT=80
#
# Getting this wrong is quiet: the request hits the web server's 404 page, which parses
# as zero metric lines and reads as an idle production rather than a bad URL.
IRIS_BASE_PATH=

# Per-host queue depth and error counts endpoint (iris/labdemo/REST/HostStatusDispatcher.cls),
# polled on the metrics interval and merged into /proxy/metrics by host name.
#
# This is what makes `queued` and `errored` real numbers instead of null: neither
# iris_interop_queued nor iris_interop_messages_errored carries a `host` label, so those
# two values are not in /api/monitor/metrics at all (issues #12, #31).
#
# NOTE this is an ABSOLUTE path and IRIS_BASE_PATH is NOT applied to it. The two point at
# different web applications:
#
#   IRIS_BASE_PATH + /api/monitor/metrics   the instance's built-in monitor API
#   /labdemo/monitor/hoststatus             a separate CSP app in the LABDEMO namespace
#
# Set it EMPTY to disable the third poll — the proxy then publishes queued/errored as
# null, exactly as it did before. That is the honest setting for an instance where the
# dispatcher class and its web application are not deployed.
IRIS_HOSTSTATUS_PATH=/labdemo/monitor/hoststatus

# How often to poll /api/monitor/metrics (milliseconds). Default: 10000.
# The host-status endpoint is polled on this same interval.
METRICS_POLL_INTERVAL_MS=10000

# How often to poll /api/monitor/alerts (milliseconds). Default: 30000.
ALERTS_POLL_INTERVAL_MS=30000

# Port this proxy listens on. Must match root CLAUDE.md §5.
PROXY_PORT=3001
