# Copy this file to .env and fill in your IRIS connection details.
# Never commit .env — it is in .gitignore.

IRIS_HOST=localhost
IRIS_PORT=52773
IRIS_USER=_SYSTEM
IRIS_PASS=SYS
IRIS_NAMESPACE=LABDEMO

# Path prefix in front of /api/monitor/. Leave empty when IRIS is served by its own
# private web server (the 52773 case). When IRIS is served through an external web
# server the instance name is a path segment, so check the URL that works in your
# browser and copy everything before /api/:
#
#   http://localhost:52773/api/monitor/metrics          -> IRIS_BASE_PATH=
#   http://localhost/iris4health_2024_1/api/monitor/... -> IRIS_BASE_PATH=/iris4health_2024_1
#                                                          with IRIS_PORT=80
#
# Getting this wrong is quiet: the request hits the web server's 404 page, which parses
# as zero metric lines and reads as an idle production rather than a bad URL.
IRIS_BASE_PATH=

# How often to poll /api/monitor/metrics (milliseconds). Default: 10000.
METRICS_POLL_INTERVAL_MS=10000

# How often to poll /api/monitor/alerts (milliseconds). Default: 30000.
ALERTS_POLL_INTERVAL_MS=30000

# Port this proxy listens on. Must match root CLAUDE.md §5.
PROXY_PORT=3001
